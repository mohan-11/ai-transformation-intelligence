# ============================================================
# AI Transformation Strategy Intelligence — environment config
# Copy to `.env` and fill in. NEVER commit `.env`.
# All values are optional — the app runs fully offline with
# sensible defaults (heuristic LLM + TF-IDF embeddings + in-memory
# vector store) when nothing is configured.
# ============================================================

# --- Application ---
APP_NAME="AI Transformation Strategy Intelligence"
API_PREFIX="/api"

# --- Database ---
# SQLite by default. To migrate to PostgreSQL, set:
#   DATABASE_URL="postgresql+psycopg2://user:pass@localhost:5432/aitransform"
DATABASE_URL="sqlite:///./data/app.db"

# --- Paths (relative to project root) ---
CHROMA_DIR="./data/chroma"
KNOWLEDGE_DIR="./data/knowledge"
UPLOAD_DIR="./data/uploads"

# --- LLM provider ---
# auto | openai | deepseek | gemini | ollama | heuristic
# "auto" tries a configured API key first, then falls back to the
# deterministic heuristic provider (no network, no key required).
LLM_PROVIDER="auto"

# Generic OpenAI-compatible endpoint (works for OpenAI, DeepSeek,
# vLLM, Ollama, Together, etc.):
LLM_API_KEY=""
LLM_BASE_URL=""          # e.g. https://api.openai.com/v1  or  https://api.deepseek.com
LLM_MODEL=""             # e.g. gpt-4o-mini  or  deepseek-chat

# Gemini (Google):
GOOGLE_API_KEY=""

# --- Embeddings ---
# auto | sentence-transformers | tfidf | hashing
EMBEDDING_PROVIDER="auto"
SENTENCE_TRANSFORMER_MODEL="all-MiniLM-L6-v2"

# --- Vector store ---
# auto | chroma | memory
VECTOR_STORE="auto"

# --- Scoring weights (sum need not be exactly 1.0; normalised) ---
# Priority = business_value*w_bv + strategic_alignment*w_sa
#          + data_readiness*w_dr + feasibility*w_fe
#          - complexity*w_cx - risk*w_rk
W_BUSINESS_VALUE="0.30"
W_STRATEGIC_ALIGNMENT="0.20"
W_DATA_READINESS="0.15"
W_FEASIBILITY="0.15"
W_COMPLEXITY="0.10"
W_RISK="0.10"

# --- RAG / analysis ---
TOP_K_CAPABILITIES="3"
TOP_K_CHUNKS="5"
ANALYSIS_TIMEOUT_SECONDS="60"

# --- Security ---
MAX_UPLOAD_MB="20"
